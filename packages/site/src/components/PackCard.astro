---
import { formatRate } from '@plugdex/data';
import type { PackVerdict } from '@plugdex/data';

import InstallDialog from './InstallDialog.astro';
import VerdictChip from './VerdictChip.astro';

/**
 * One pack, one card.
 *
 * The author is rendered as it is stored: DEC-014 tags every attribution as `upstream`
 * (the author's own declaration) or `curated` (ours), and flattening the two to a bare
 * string would make our claim about a real person indistinguishable from theirs. The
 * `curated` tag is surfaced, not hidden.
 *
 * The rates share one class and one style. The verdict function no longer decides
 * whether a difference is real, and a card that styles the larger rate differently would
 * be making that claim on its behalf.
 *
 * **Two populations, side by side** (PDX-005 AC-2). The headline this card published until
 * now counted frontend cells only — every build-graded cell in the corpus is a frontend
 * ticket — and said nothing about it. The backend cells are graded by whether the delivered
 * code imports and adds no new diagnostic, which is a different gate over different tickets
 * and runs no tests at all, so they are printed beside
 * the frontend rates rather than folded into them or left out. Four rates, two named
 * populations, and no comparison drawn between any of them.
 */
interface Props {
  packId: string;
  displayName: string;
  author: { from: string; value: string };
  upstreamRepo: string;
  stars: { count: number; readAt: string };
  verdict: PackVerdict;
}

const { packId, displayName, author, upstreamRepo, stars, verdict } = Astro.props;

/**
 * The four rates, in two populations, formatted by the package that holds the records.
 *
 * The conversion is imported rather than written here on purpose: DATA-01 blocks a typed
 * figure in site source, and `Math.round(x * 100)` needs a literal. Keeping it in
 * `@plugdex/data` leaves this component with no numeric literal on the figure path at
 * all, which is what lets the gate be absolute instead of maintaining an allowlist that
 * would eventually admit a real one.
 */
const rates =
  verdict.verdict === 'build-rate'
    ? {
        frontend:
          verdict.n > 0 && verdict.baselineN > 0
            ? {
                pack: formatRate({ hits: verdict.builds, n: verdict.n, population: 'frontend' }),
                baseline: formatRate({
                  hits: verdict.baselineBuilds,
                  n: verdict.baselineN,
                  population: 'frontend',
                }),
              }
            : null,
        backend:
          verdict.backendN > 0 && verdict.baselineBackendN > 0
            ? {
                pack: formatRate({
                  hits: verdict.backendPasses,
                  n: verdict.backendN,
                  population: 'backend',
                }),
                baseline: formatRate({
                  hits: verdict.baselineBackendPasses,
                  n: verdict.baselineBackendN,
                  population: 'backend',
                }),
              }
            : null,
      }
    : null;
---

<li class="card" data-pack-id={packId}>
  <h2>{displayName}</h2>

  <p class="byline">
    by {author.value}
    {author.from === 'curated' ? <span class="curated">(attributed by plugdex)</span> : null}
  </p>

  <VerdictChip verdict={verdict} />

  {
    rates?.frontend ? (
      <p class="rates">
        <span class="rate" data-rate="pack" data-population="frontend">
          <span class="rate-label">builds</span> {rates.frontend.pack}
        </span>
        <span class="rate" data-rate="baseline" data-population="frontend">
          <span class="rate-label">baseline</span> {rates.frontend.baseline}
        </span>
      </p>
    ) : null
  }

  {
    rates?.backend ? (
      <p class="rates">
        <span class="rate" data-rate="pack-backend" data-population="backend">
          <span class="rate-label">passes</span> {rates.backend.pack}
        </span>
        <span class="rate" data-rate="baseline-backend" data-population="backend">
          <span class="rate-label">baseline</span> {rates.backend.baseline}
        </span>
      </p>
    ) : null
  }

  <p class="stars">
    <span class="mono">{stars.count}</span> stars, read {stars.readAt}
  </p>

  <InstallDialog packId={packId} displayName={displayName} upstreamRepo={upstreamRepo} />
</li>
