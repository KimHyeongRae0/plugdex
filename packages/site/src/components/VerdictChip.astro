---
import { formatRate, percentOf } from '@plugdex/data';
import type { PackVerdict } from '@plugdex/data';

/**
 * Renders one verdict object.
 *
 * Every figure on this chip is a field of the object it was handed. There is no
 * arithmetic here beyond turning a numerator and a denominator into a percentage, and no
 * literal a reader could see — which is what makes DATA-01 hold at this boundary rather
 * than by review. The shape glyph is the primary signal (SC 1.4.1) and renders in ink;
 * the status hue is background and border only (DEC-018).
 *
 * The build-rate chip names its population (PDX-005 AC-2). `percentOf` stays for the
 * no-code chip, whose percentage is a share of silent cells and has no frontend or backend
 * to name — the denominator sits in the same element either way.
 */
interface Props {
  verdict: PackVerdict;
}

const { verdict } = Astro.props;

/** Glyph and label per verdict, from the DESIGN.md chip table. */
const describe = ({ value }: { value: PackVerdict }): { glyph: string; label: string } => {
  if (value.verdict === 'no-code') {
    const percent = percentOf({ hits: value.silent, n: value.n });

    return { glyph: '░', label: `writes no code in ${percent}% of cells, n=${value.n}` };
  }

  if (value.verdict === 'claim-not-reproduced') {
    return {
      glyph: '▫',
      label: `published ${value.metric} claim not reproduced: claimed ${value.claimed}, measured ${value.low}–${value.high}`,
    };
  }

  if (value.verdict === 'build-rate') {
    // The population is part of the rate, not a caption beside it: this chip counts
    // frontend cells and said so nowhere until PDX-005. `formatRate` bakes the name in,
    // so a chip cannot render the number without it.
    if (value.n <= 0) {
      return { glyph: '▫', label: 'no graded frontend cell' };
    }

    return {
      glyph: '▪',
      label: `builds ${formatRate({ hits: value.builds, n: value.n, population: 'frontend' })}`,
    };
  }

  return { glyph: '·', label: 'unmeasured' };
};

const { glyph, label } = describe({ value: verdict });
---

<span class="chip" data-verdict={verdict.verdict} data-glyph={glyph}>
  <span class="glyph" aria-hidden="true">{glyph}</span>
  <span>{label}</span>
</span>
